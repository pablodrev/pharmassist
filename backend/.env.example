# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=pharmadb
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/pharmadb

# API Configuration
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — разрешённые origins для браузерных запросов (нужно только при локальной разработке,
# в Docker-режиме nginx проксирует запросы от одного origin, CORS не требуется)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM Configuration
# By default uses Yandex Cloud API (recommended)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=yandex

# Yandex Cloud (required - get from https://console.cloud.yandex.com/)
YANDEX_CLOUD_FOLDER=<your-folder-id>
YANDEX_CLOUD_API_KEY=<your-api-key>

HF_TOKEN=<your-huggingface-token-here>

# To switch to local Ollama (not recommended for production):
# LLM_PROVIDER=ollama
# LLM_MODEL=mistral
# Make sure Ollama is running: ollama serve
